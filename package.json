{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/build.js",
    "audit:content": "node tools/content-audit.js",
    "audit:repo": "node tools/repo-hygiene.js",
    "album:fetch": "python3 scripts_py/fetch_daily_images.py --per-category 3 --no-pinterest",
    "album:audit": "node tools/album-maintenance.js",
    "album:dedupe": "node tools/album-maintenance.js --apply --delete-unreferenced",
    "image:prepare": "node tools/image-pipeline.js prepare",
    "image:retry": "node tools/image-pipeline.js retry",
    "test:image-pipeline": "node tools/image-pipeline.test.js",
    "clean": "npx hexo clean",
    "deploy": "npx hexo deploy",
    "server": "node tools/hexo-server.js",
    "dev": "node tools/hexo-server.js --sync-knowledge --watch",
    "new": "npx hexo new",
    "article:ids": "node tools/ensure-article-ids.js",
    "knowledge:sync": "node tools/sync-knowledge.mjs",
    "sync:demos": "node tools/sync-demos.mjs",
    "audit:demos": "node tools/sync-demos.mjs --check"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "get-intrinsic": "^1.2.4",
    "gopd": "^1.0.1",
    "hexo": "^7.0.0",
    "hexo-algoliasearch": "^2.0.1",
    "hexo-deployer-git": "^4.0.0",
    "hexo-feed": "^1.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-neat": "^1.0.9",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-symbols-count-time": "^0.7.1",
    "hexo-theme-fluid": "^1.9.8",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-wordcount": "^6.0.1",
    "js-yaml": "^4.3.2",
    "remark-pangu": "^2.2.0",
    "sharp": "^0.34.5"
  }
}
